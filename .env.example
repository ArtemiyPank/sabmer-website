# Postgres connection string (Neon via Vercel Marketplace in production)
DATABASE_URI=
# Long random string used to encrypt Payload sessions
PAYLOAD_SECRET=

# The first admin user, created by `npm run seed` when the database has none.
# Pick a real password: whoever reaches /admin first on an empty database gets
# to claim the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The site's own origin, e.g. https://sabmer.co.il. When set, the CMS holds
# admin requests to it (CORS and CSRF).
NEXT_PUBLIC_SITE_URL=
