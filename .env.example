# Postgres connection string (Neon via Vercel Marketplace in production)
DATABASE_URI=
# Long random string used to encrypt Payload sessions
PAYLOAD_SECRET=

# The first admin user, created by `npm run seed` (and by the deploy) when the
# database has none. Pick a real password: whoever reaches /admin first on an
# empty database gets to claim the account.
#
# The admin signs in with ADMIN_USERNAME, never with the email address — so
# pick one that is not published anywhere, and keep it with the password. On
# an existing database the migration `username_login` gives it to the one
# account that has none yet. ADMIN_EMAIL is optional.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# The site's own origin. Optional, and an override rather than a setting:
# deployed on Vercel the domain is taken from VERCEL_PROJECT_PRODUCTION_URL,
# which Vercel sets itself, and anywhere else it falls back to the real one in
# lib/site.ts. Leave it EMPTY in local development — setting it would hold the
# admin's CORS and CSRF to the live origin and lock the local login out.
NEXT_PUBLIC_SITE_URL=
