{
  "name": "elevator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "npm run migrate:deploy && npm run bootstrap && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate": "payload migrate",
    "migrate:deploy": "sh scripts/migrate-deploy.sh",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "bootstrap": "sh -c 'if [ -n \"$DATABASE_URL_UNPOOLED\" ]; then export DATABASE_URI=\"$DATABASE_URL_UNPOOLED\"; fi; exec payload run scripts/bootstrap.ts'",
    "seed": "payload run scripts/seed.ts",
    "types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^12.42.2",
    "graphql": "^16.14.2",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "payload": "^3.88.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
